# otsu 설정. DATA_DIR/.env로 복사해서 쓴다.
# "시작할 때만" 표시가 있는 값은 바꾸면 재시작해야 한다. 나머지는 이벤트마다 다시 읽는다.

# 시간
TIMEZONE=Asia/Seoul
# 불가 시간대. 콤마로 여러 구간. 자정을 넘는 구간 허용 (예: 23:00-02:00)
BLACKOUT=00:00-08:00

# 스케줄 (next.at 허용 범위)
MIN_INTERVAL_MIN=1
MAX_DELAY_HOURS=48

# 랜덤 이벤트
RANDOM_UNIT_MIN=60
RANDOM_TRIALS=1
RANDOM_PROB=0.15
RANDOM_MAX_DUE=3

# 텔레그램
# 시작할 때만
TELEGRAM_BOT_TOKEN=
# 시작할 때만
TELEGRAM_OWNER_CHAT_ID=
DEBOUNCE_SEC=20
SEND_INTERVAL_MS=1000

# LLM
# deepseek | openai. openai면 잔액 확인을 건너뛴다. 시작할 때만
LLM_PROVIDER=deepseek
# 시작할 때만
LLM_BASE_URL=https://api.deepseek.com
# 시작할 때만
LLM_API_KEY=
LLM_MODEL=deepseek-flash
MAX_TOOL_ROUNDS=3
MAX_CLEANUP_TOOL_ROUNDS=5
FALLBACK_DELAY_MIN=10
FALLBACK_MAX_DELAY_MIN=120
ALERT_AFTER=3
# API 요청 수. $1/일 ÷ 요청당 $0.0025. 모델을 바꾸면 다시 계산
DAILY_CALL_LIMIT=400

# 잔액 (계정 통화 기준)
BALANCE_THRESHOLD=1.0
BALANCE_RETRY_MIN=30

# 기억
FLOW_COMPACT_TOKENS=12000
MEMORY_FILE_MAX_CHARS=8000
MEMORY_MAX_FILES=8
CLEANUP_RETRY=2
