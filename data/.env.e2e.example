# E2E 점검용 설정. 실제 API와 실제 봇으로 짧은 주기를 돌린다.
# data/.env로 복사하고 비어 있는 값을 채운다. 아래에 없는 값은 data/.env.example의 초기값을 쓴다.

TIMEZONE=Asia/Seoul
# 지금 시각에서 몇 분 뒤의 짧은 구간으로 바꾼다 (예: 지금이 14:20이면 14:30-14:40)
BLACKOUT=00:00-00:01

MIN_INTERVAL_MIN=1
MAX_DELAY_HOURS=1

# 랜덤 이벤트가 자주 쌓이게
RANDOM_UNIT_MIN=5
RANDOM_TRIALS=1
RANDOM_PROB=0.8
RANDOM_MAX_DUE=3

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
DEBOUNCE_SEC=5
SEND_INTERVAL_MS=1000

# openai | deepseek. 둘 다 한 번씩 돌린다
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none

FALLBACK_DELAY_MIN=1
FALLBACK_MAX_DELAY_MIN=4
DAILY_CALL_LIMIT=200
