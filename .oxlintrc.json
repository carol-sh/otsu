{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node"],
  "env": {
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "style": "off"
  },
  "rules": {
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["test/**", "scripts/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
